# Copy to .env and fill in. NEVER commit the real file.
# Behavioural settings (universe, windows, thresholds) live in config.yaml,
# which IS committed. Only secrets and deployment details belong here.

SECTOR_DATABASE_URL=postgresql+psycopg2://localhost:5432/sector_breakout
SECTOR_LOG_LEVEL=INFO

# Schwab Trader API — only needed when config.yaml sets data.provider: schwab.
# Refresh tokens expire every 7 days and must be renewed manually.
# SECTOR_SCHWAB_CLIENT_ID=
# SECTOR_SCHWAB_CLIENT_SECRET=
# SECTOR_SCHWAB_REFRESH_TOKEN=
