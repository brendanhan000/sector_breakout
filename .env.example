# Copy to .env and fill in. NEVER commit the real file.
# Behavioural settings (universe, windows, thresholds) live in config.yaml,
# which IS committed. Only secrets and deployment details belong here.

SECTOR_DATABASE_URL=postgresql+psycopg2://localhost:5432/sector_breakout
SECTOR_LOG_LEVEL=INFO

